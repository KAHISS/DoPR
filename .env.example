# Crie um token fine-grained com acesso ao repositório:
# Contents: read; Pull requests: write; Metadata: read.
GH_TOKEN=coloque-seu-token-aqui

# Opcional: endereço diferente para o Ollama no host.
OLLAMA_URL=http://host.docker.internal:11434

# Opcional: chaves para provedores hospedados.
OPENAI_API_KEY=
LLM_API_KEY=
