# Fine-grained token: Contents read, Issues read/write, Pull requests read/write.
# Para Projects V2 pessoais, use um token classic com escopo project (veja README).
GH_TOKEN=coloque-seu-token-aqui

# Opcional: endereço diferente para o Ollama no host.
OLLAMA_URL=http://host.docker.internal:11434

# Opcional: chaves para provedores hospedados.
OPENAI_API_KEY=
LLM_API_KEY=
